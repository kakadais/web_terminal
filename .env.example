# Copy this file to .env.local and set TERM_TOKEN before starting the server.
# Values already set in the process environment take precedence.

# HTTP / WebSocket listener
HOST=0.0.0.0
PORT=5894

# Required access token. Set your own value; no token is supplied by default.
TERM_TOKEN=

# server_blacklist.js settings
# Enable only when the server is behind a trusted reverse proxy.
TRUST_PROXY=false
TERM_MAX_FAILS=5
TERM_BLOCK_MS=86400000
TERM_FAIL_WINDOW_MS=600000

# Relative paths are resolved from the project root.
TERM_DB_DIR=./data
TERM_DB_FILE=ip_security.db

# Optional Unix shell override; otherwise the process's SHELL is used.
# SHELL=/bin/bash
