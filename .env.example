# Copy to .env.local and chmod 600 .env.local. Meteor settings are not used.
PORT=5160
BIND_IP=192.168.1.4
ROOT_URL=https://terminal.digix.kr
HTTP_FORWARDED_COUNT=1

# Create a dedicated readWrite user in the web_terminal database.
# Percent-encode reserved characters in the database password.
MONGO_URL="mongodb://web_terminal_app:CHANGE_ME@127.0.0.1:27777/web_terminal?authSource=web_terminal&replicaSet=meteor"
MONGO_OPLOG_URL=""

# Used only when the administrator does not exist yet.
ADMIN_USERNAME=kakadais
ADMIN_PASSWORD="CHANGE_ME"

# Generate once with: openssl rand -hex 32
# Keep this key across deployments, and back it up with database backups.
CREDENTIAL_ENCRYPTION_KEY=""

# Paths are resolved on the application server.
SSH_CONFIG_PATH="~/.ssh/config"
SSH_KNOWN_HOSTS_PATH="~/deploy/web_terminal/shared/known_hosts"
SSH_COMMAND=/usr/bin/ssh
TERMINAL_MAX_SESSIONS=12
TERMINAL_TICKET_SECONDS=30
TERMINAL_IDLE_MINUTES=60
DEV_PORT=5160
